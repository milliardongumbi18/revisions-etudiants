# Copier ce fichier en .env et remplir les valeurs.
SECRET_KEY=a-remplacer-par-une-longue-cle-aleatoire
DEBUG=True

# DATABASE_URL sera configuré en production.
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base?sslmode=require
# Génération de quiz : "gemini" (défaut) ou "fake" (démo sans réseau ni clé)
# AI_PROVIDER=gemini
GEMINI_API_KEY=a-remplacer
# Compte de démonstration (public, réinitialisé à chaque déploiement)
# DEMO_PASSWORD=Demo-Kinshasa-2026
# E-mails (production) : envoi par l'API Brevo
# EMAIL_BACKEND=core.email_backend.BrevoEmailBackend
# BREVO_API_KEY=a-remplacer
# DEFAULT_FROM_EMAIL=Révisions Étudiants <adresse-verifiee-sur-brevo@exemple.cd>
